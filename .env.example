# Copy to .env before running `docker-compose up -d`.
# These are the variables docker-compose.yml reads from the environment.

# --- PostgreSQL ---
POSTGRES_USER=chronos_user
POSTGRES_PASSWORD=chronos_password
POSTGRES_DB=chronos

# --- LLM Providers (leave empty to disable fork LLM calls for that provider) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Security ---
# CHRONOS_API_KEYS holds comma-separated SHA-256 HASHES of accepted API keys
# (clients send the plaintext key in X-API-Key; the backend hashes and compares).
# The hash below is sha256("chronos_demo_key_12345") — the demo key used by
# generate_demo_trace.py. Replace with hashes of your own keys in production.
CHRONOS_API_KEYS=88c4134e2b17d5f91fa1db5422222dfc3d5db6a2a54525af09564f87598cbf22
CHRONOS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CHRONOS_ADMIN_PASSWORD=change-me
